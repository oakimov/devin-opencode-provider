{
  "name": "devin-opencode-provider",
  "version": "0.1.1",
  "description": "Use Devin/Windsurf subscription models from OpenCode via Windsurf's Connect-RPC Cascade protocol",
  "type": "module",
  "license": "MIT",
  "author": "devin-opencode-provider",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oakimov/devin-opencode-provider.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "devin",
    "windsurf",
    "ai-sdk",
    "provider",
    "plugin"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.15"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.17.13"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.16",
    "@tsconfig/node22": "^22.0.6",
    "@types/bun": "^1.3.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "@types/bun__test": "^1.1.0"
  }
}
